  m_Script: {fileID: 11500000, guid: 6088f894dcfbda042b56ecd18b888e91, type: 3}
  m_Name: Night 1 - Clown Greeting
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: The Clown
    portrait: {fileID: 0}
    text: Ohh... we have guests, I see!
  - speaker: The Clown
    portrait: {fileID: 0}
    text: Nice to meet you. It's been so lonely in here since the last family...
      left.
  - speaker: The Clown
    portrait: {fileID: 0}
    text: Ready to play? Hide well... and pray I don't find you.
  flagToSetWhenFinished: metClown
